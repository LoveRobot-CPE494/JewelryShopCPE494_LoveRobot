# Line endings: normalize all text to LF in the index AND the working tree, whatever
# core.autocrlf says (Git for Windows defaults it to true). Unity always writes LF, so a
# CRLF checkout makes every Unity re-save look modified with an empty diff (#28).
# Keep this block ABOVE the LFS rules: later lines win, and the LFS lines set -text on binaries.
# Batch files (.bat, .cmd) get an `eol=crlf` override below; PowerShell reads LF fine.
* text=auto eol=lf
# cmd.exe misreads labels and goto in LF batch files: keep them CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Unity binary assets go through Git LFS (GitHub rejects files over 100 MB).
# Each teammate runs `git lfs install` once per machine.
# Patterns are case-insensitive because Asset Store / Sketchfab packs often ship .PNG, .FBX.
# Unity text assets (.asset, .prefab, .unity, .mat, .anim, .meta) stay plain git.

# 3D models
*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
*.[oO][bB][jJ] filter=lfs diff=lfs merge=lfs -text
*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
