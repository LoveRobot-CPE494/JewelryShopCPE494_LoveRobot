    {"name": "joint", "message": {"type": "joint", "j1": 10.0, "j2": 20.0, "j3": 30.0, "j4": 0.0}},
    {"name": "speed", "message": {"type": "speed", "value": 30}},
    {"name": "enable", "message": {"type": "enable"}},
    {"name": "disable", "message": {"type": "disable"}},
    {"name": "clear_error", "message": {"type": "clear_error"}},
    {"name": "resume", "message": {"type": "resume"}},
    {"name": "jog_x_plus_10", "message": {"type": "jog", "axis": "x", "step": 10}},
    {"name": "jog_z_minus_1", "message": {"type": "jog", "axis": "z", "step": -1}},
    {"name": "jog_y_plus_50", "message": {"type": "jog", "axis": "y", "step": 50}},
